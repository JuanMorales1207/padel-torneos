<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.com.padel.controller.CouplesController"
      styleClass="content-area">

    <ToolBar styleClass="content-toolbar">
        <Button text="Nuevo"
                onAction="#onNuevo"
                styleClass="button-primary"/>

        <Button text="Editar"
                onAction="#onEditar"
                styleClass="button-secondary"/>

        <Button text="Borrar"
                onAction="#onBorrar"
                styleClass="button-danger"/>
    </ToolBar>

    <TableView fx:id="couplesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nombreColumn"
                         text="Nombre de pareja"
                         prefWidth="220"/>

            <TableColumn fx:id="jugador1Column"
                         text="Jugador 1"
                         prefWidth="220"/>

            <TableColumn fx:id="jugador2Column"
                         text="Jugador 2"
                         prefWidth="220"/>
                         
            <TableColumn fx:id="activaColumn"
             text="Activa"
             prefWidth="80"/>

            <TableColumn fx:id="fechaRegistroColumn"
                         text="Fecha de registro"
                         prefWidth="180"/>
        </columns>
    </TableView>

</VBox>
