<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      prefWidth="450"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.com.padel.controller.content.dialog.TournamentRoundDialogController"
      style="-fx-padding: 20;">

    <Label text="Datos de la jornada"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="15">

        <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Número de jornada:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="roundNumberField"
                   editable="false"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Descripción:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="descriptionField"
                   promptText="Ej. Fase de grupos"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Fecha de inicio:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="startDatePicker"
                    promptText="Inicio"
                    maxWidth="Infinity"
                    GridPane.rowIndex="2"
                    GridPane.columnIndex="1"/>

        <Label text="Fecha de finalización:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="endDatePicker"
                    promptText="Finalización"
                    maxWidth="Infinity"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"/>

    </GridPane>

    <Separator/>

    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button text="Cancelar"
                onAction="#onCancelar"
                cancelButton="true"/>

        <Button fx:id="btnSave"
                text="Guardar"
                defaultButton="true"
                onAction="#onGuardar"/>

    </HBox>

</VBox>