<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.com.padel.controller.content.dialog.ModifyUserDialogController"
      spacing="15"
      prefWidth="620"
      styleClass="dialog-container">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Encabezado y acciones -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Mi cuenta" styleClass="dialog-title"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnEdit"
                text="Editar"
                onAction="#onEdit"/>

        <Button fx:id="btnCancel"
                text="Cancelar"
                onAction="#onCancel"
                visible="false"
                managed="false"
                cancelButton="true"/>

        <Button fx:id="btnSave"
                text="Guardar"
                onAction="#onSave"
                visible="false"
                managed="false"
                defaultButton="true"
                styleClass="primary-button"/>
    </HBox>

    <Separator/>

    <!-- Información personal -->
    <Label text="Información personal" styleClass="section-title"/>

    <GridPane hgap="15" vgap="12">

        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints percentWidth="50"/>
            <javafx.scene.layout.ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Nombre"/>
            <TextField fx:id="txtName" promptText="Nombre"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Apellido"/>
            <TextField fx:id="txtLastName" promptText="Apellido"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Usuario"/>
            <TextField fx:id="txtUserId" editable="false"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Fecha de nacimiento"/>
            <DatePicker fx:id="dpBirthday" maxWidth="Infinity"/>
        </VBox>

    </GridPane>

    <Separator/>

    <!-- Seguridad -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Seguridad" styleClass="section-title"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnEnablePasswordChange"
                text="Cambiar contraseña"
                onAction="#onEnablePasswordChange"/>
    </HBox>

    <VBox fx:id="passwordSection" spacing="10"
          visible="false" managed="false">

        <VBox spacing="5">
            <Label text="Contraseña actual"/>
            <PasswordField fx:id="txtCurrentPassword"
                           promptText="Contraseña actual"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Nueva contraseña"/>
            <PasswordField fx:id="txtNewPassword"
                           promptText="Nueva contraseña"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Repetir nueva contraseña"/>
            <PasswordField fx:id="txtRepeatPassword"
                           promptText="Repetir contraseña"/>
        </VBox>

    </VBox>

</VBox>
