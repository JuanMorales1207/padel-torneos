<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.com.padel.controller.content.EmployeesController"
      styleClass="content-area">

    <ToolBar fx:id="toolbar" styleClass="content-toolbar">

        <Button text="Nuevo"
                onAction="#onNuevo"
                styleClass="button-primary"/>

        <Button text="Editar"
                onAction="#onEditar"
                styleClass="button-secondary"/>

        <Button text="Borrar"
                onAction="#onBorrar"
                styleClass="button-danger"/>

    </ToolBar>

    <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
        <columns>

            <TableColumn fx:id="nombreColumn"
                         text="Nombre"
                         prefWidth="180"/>

            <TableColumn fx:id="apellidoColumn"
                         text="Apellido"
                         prefWidth="180"/>

            <TableColumn fx:id="usuarioColumn"
                         text="Usuario"
                         prefWidth="130"/>

            <TableColumn fx:id="rolColumn"
                         text="Rol"
                         prefWidth="150"/>

            <TableColumn fx:id="fechaIngresoColumn"
                         text="Fecha de ingreso"
                         prefWidth="150"/>

            <TableColumn fx:id="fechaFinalizacionColumn"
                         text="Fecha de finalización"
                         prefWidth="170"/>

            <TableColumn fx:id="activoColumn"
                         text="Activo"
                         prefWidth="80"/>

        </columns>
    </TableView>

</VBox>